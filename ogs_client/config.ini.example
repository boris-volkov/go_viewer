username=your-ogs-username
password=your-ogs-password

# Optional: paste a JWT token instead of (or in addition to) username/password.
# Get it from browser devtools on online-go.com → Application → Local Storage → ogs_user_jwt
# jwt=eyJ...

# Optional: KataGo analysis engine. All three fields required to enable analysis.
# Paths may be absolute (C:\path\to\...) or relative — a relative path resolves
# against the folder ogs_client.exe itself is in, regardless of how it's launched.
# Recommended: drop KataGo into a "katago" folder next to ogs_client.exe and use:
# katago_exe=katago\katago.exe
# katago_model=katago\model.bin.gz
# katago_config=katago\analysis_example.cfg
# katago_model_9x9=katago\model_9x9.bin.gz

# Optional: path to the human SL model (humanv0.bin.gz) to enable "VS KATAGO"
# local games at adjustable strength (20k to 5d).
# Download from: https://github.com/lightvector/KataGo/releases/tag/v1.15.0
# katago_human_model=katago\humanv0.bin.gz
